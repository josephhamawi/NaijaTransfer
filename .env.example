# ─────────────────────────────────────────────────────────
# NigeriaTransfer Environment Variables
# Copy to .env.local and fill in real values
# ─────────────────────────────────────────────────────────

# ─── Data ────────────────────────────────────────────────
# There is no SQL database. Everything lives in Firestore; Google
# sign-in is configured in the Firebase console, not here.

# ─── Paystack (Payments) ────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxx"
PAYSTACK_PRO_PLAN_CODE="PLN_xxx"
PAYSTACK_BUSINESS_PLAN_CODE="PLN_xxx"

# ─── Firebase (Auth, Firestore, Storage) ────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="xxx"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="naijatransfer.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="naijatransfer"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="naijatransfer.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="xxx"
NEXT_PUBLIC_FIREBASE_APP_ID="xxx"
FIREBASE_STORAGE_BUCKET="naijatransfer.firebasestorage.app"
# Local dev only — on App Hosting, signing uses the runtime service
# account via IAM signBlob, so no key file is needed.
FIREBASE_SERVICE_ACCOUNT=""

# ─── Brevo (Transactional Email) ────────────────────────
BREVO_API_KEY="xkeysib-xxx"
BREVO_SENDER_EMAIL="noreply@nigeriatransfer.com"
BREVO_SENDER_NAME="NigeriaTransfer"

# ─── Termii (Phone OTP) ─────────────────────────────────
TERMII_API_KEY="xxx"
TERMII_SENDER_ID="NigeriaT"

# ─── Application ────────────────────────────────────────
CRON_SECRET="generate-a-random-secret-here"
STORAGE_THRESHOLD_PERCENT="85"
MAX_CONCURRENT_UPLOADS="10"
APP_URL="http://localhost:3000"

# Monthly ceiling, in GB, on downloads served to free/anonymous traffic.
# GCS bills ~$0.12/GB egress, so 50 GB ≈ $6/month worst case.
EGRESS_BUDGET_GB_MONTH="50"

# ─── Live Send (free tier, WebRTC) ──────────────────────
# STUN servers for ICE discovery, comma separated. Firebase has no
# managed STUN/TURN service; these are Google's public servers, free
# and with no SLA. No TURN relay is configured on purpose — relayed
# bytes would cost per GB, which is what Live Send avoids.
NEXT_PUBLIC_LIVE_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# App Check (optional abuse control on Live Send room creation).
# Leave the site key blank until reCAPTCHA v3 is registered in the
# Firebase console — a missing token is soft-failed by the server.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=""
FIREBASE_APPCHECK_ENFORCE="false"

# ─── Analytics ──────────────────────────────────────────
UMAMI_URL="https://analytics.nigeriatransfer.com"
UMAMI_WEBSITE_ID="xxx"

# ─── Kodefoundry CRM (optional) ─────────────────────────
# Leave blank to disable all CRM tracking — the app runs identically without it.
# Get appId/apiKey from the CRM dashboard after registering this app.
CRM_APP_ID=""
CRM_API_KEY=""
CRM_ENDPOINT="https://api-ei3nxpoa5q-uc.a.run.app"
