rules_version = '2';

// ─────────────────────────────────────────────────────────
// NigeriaTransfer — Firestore security rules
//
// Every read and write in this app goes through the Firebase Admin SDK
// inside Next.js route handlers, which bypasses these rules entirely.
// No browser code touches Firestore directly.
//
// So the correct policy is deny-all. This is not a placeholder: a
// permissive rule here would expose transfer docs (which carry
// passwordHash, recipient emails and storage keys) to anyone with the
// project's public web API key.
//
// If a client-direct read is ever genuinely needed, add a narrow rule
// for that one collection — never widen this default.
// ─────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
